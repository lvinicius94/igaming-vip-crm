# ─────────────────────────────────────────────────────────────
#  vip-players — variáveis de ambiente (exemplo). Nenhum valor real.
# ─────────────────────────────────────────────────────────────

# ── Modo demo (portfólio) ────────────────────────────────────
# Com DEMO_MODE=true, um middleware intercepta /api/* e devolve VIPs
# FICTÍCIOS — o app abre populado e sem login, sem precisar de banco.
DEMO_MODE=true

# ── Banco de Dados PostgreSQL (read-only) ────────────────────
PGHOST=your-database-host.com
PGPORT=5432
PGUSER=your-username
PGPASSWORD=your-password
PGDATABASE=your-database
PGSSLMODE=require
# PGSSLROOTCERT=path/to/certificate.pem

# ── Login do dashboard (hashes SHA256) ───────────────────────
# Usuário 1 — Admin (senha: admin@123)
AUTH_USER1=admin
AUTH_PASS1_HASH=7676aaafb027c825bd9abab78b234070e702752f625b752e55e55b48e607e358
# Usuário 2 — Atendimento (senha: atendimento@123)
AUTH_USER2=atendimento
AUTH_PASS2_HASH=2a2dc9d8b550b544cc645603751a66b089f35fee08d548b168ce440fc7c21a1d

# ── Digisac (integração WhatsApp) ────────────────────────────
DIGISAC_API_URL=https://app.digisac.example/api/v1
DIGISAC_API_TOKEN=your-digisac-api-token

# ── Chatwoot (self-hosted) ───────────────────────────────────
CHATWOOT_API_URL=https://chatwoot.example
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_API_TOKEN=your-chatwoot-token

# ── Evolution API (instâncias WhatsApp) ──────────────────────
EVOLUTION_API_URL=https://evolution.example
EVOLUTION_API_KEY=your-evolution-key

# ── Google Cloud / Smartico (BigQuery, aniversário) ──────────
GOOGLE_PROJECT_ID=your-project-id
GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour-Private-Key-Here\n-----END PRIVATE KEY-----\n"
SMARTICO_LABEL_ID=your-label-id
SMARTICO_BRAND_ID=your-brand-id
SMARTICO_API_TOKEN=your-smartico-api-token

# ── Vercel Cron ──────────────────────────────────────────────
# Gere um token: openssl rand -base64 32
CRON_SECRET=your-random-secret-token-here
